# ==========================================
# Google Gemini AI Configuration
# ==========================================
# GEMINI_API_KEY: Required for Byahedor AI features (Concierge chat, Itinerary planning, Budget optimization, Smart checklist).
# DO NOT commit your actual .env file or hardcode keys in git.
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# ==========================================
# Google Maps Platform (Optional)
# ==========================================
# VITE_GOOGLE_MAPS_API_KEY: Optional client-side API key for Google Maps Platform.
# Enables interactive Roadmap, Satellite, and Terrain maps with Advanced Markers.
# If omitted, Byahedor seamlessly uses the built-in Maps demo key fallback.
VITE_GOOGLE_MAPS_API_KEY=""

# ==========================================
# Server & Hosting Configuration
# ==========================================
# PORT: Local development and production server port (defaults to 3000)
PORT=3000

# APP_URL: The URL where this application is hosted (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"

# ==========================================
# Email & OTP Verification (Optional for Real Inbox Delivery)
# ==========================================
# If configured, 6-digit OTP codes will be sent via live SMTP directly to the recipient's inbox.
# If omitted, Byahedor automatically prepares a secure sandbox message with instant preview link and auto-fill.
# For Gmail: Use your Gmail address and generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="Byahedor Travel Concierge <your-email@gmail.com>"

